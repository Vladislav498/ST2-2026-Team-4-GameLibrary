
@model IEnumerable<ST2_2026_Team_4_GameLibrary.Models.Game>

@{
    ViewData["Title"] = "Home Page";
}

<div class="hero-section">
    <h1>Welcome to GameLibrary</h1>
    <p>Discover and explore our collection of amazing games</p>
</div>

<div class="featured-games">
    <h2>Recommended</h2>

    @if (Model != null && Model.Any())
    {
        <div class="games-grid">
            @foreach (var game in Model)
            {
                <div class="game-card">
                    <div class="game-image">
                        @if (!string.IsNullOrEmpty(game.ImagePath))
                        {
                            <img src="@game.ImagePath" alt="@game.Title" />
                        }
                        else
                        {
                            <div class="game-image-placeholder">🎲</div>
                        }
                    </div>

                    <div class="game-info">
                        <h3 class="game-title">@game.Title</h3>

                        <p class="game-description">
                            @if (!string.IsNullOrEmpty(game.Description))
                            {
                                @(game.Description.Length > 100
                                    ? game.Description.Substring(0, 100) + "..."
                                    : game.Description)
                            }
                            else
                            {
                                <span>No description available.</span>
                            }
                        </p>

                        <div class="game-actions">
                            <a asp-action="Details" asp-controller="Game" asp-route-id="@game.Id" class="btn-view">
                                View Details
                            </a>

                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <form asp-controller="Library" asp-action="Add" method="post" class="d-inline">
                                    <input type="hidden" name="gameId" value="@game.Id" />

                                    <button type="submit" class="btn btn-success">
                                        + Добави в библиотеката
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="no-games">
            <div class="no-games-icon">🎮</div>
            <p>No featured games available at the moment.</p>
            <p>Check back soon for exciting new games!</p>
        </div>
    }
</div>
