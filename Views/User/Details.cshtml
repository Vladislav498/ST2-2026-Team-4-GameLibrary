
@model ST2_2026_Team_4_GameLibrary.Models.User
@using System.Security.Claims

@{
    ViewData["Title"] = "Профил";

    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isOwnProfile = currentUserId == Model.Id;
}

<div class="container mt-4"
     data-open-profile-form="@TempData["OpenProfileForm"]">

    <h2>User Profile</h2>

    @if (TempData["ProfileMessage"] != null)
    {
        <div class="alert alert-info" role="status">
            @TempData["ProfileMessage"]
        </div>
    }

    <div class="card p-4 mb-4">
        <h4 id="displayedName">@Model.UserName</h4>

        <p>
            <strong>Email:</strong>
            @(string.IsNullOrEmpty(Model.Email) ? "Not provided" : Model.Email)
        </p>

        @if (isOwnProfile)
        {
            <hr />

            @* Change Name *@
            <form id="nameForm"
                  asp-controller="User"
                  asp-action="ChangeName"
                  method="post"
                  class="mb-3">

                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />

                <div id="nameField" hidden>
                    <label for="nameInput" class="form-label">Ново име</label>
                    <input id="nameInput"
                           name="userName"
                           class="form-control mb-2"
                           value="@Model.UserName"
                           required />
                </div>

                <button type="button"
                        id="nameButton"
                        class="btn btn-primary"
                        onclick="toggleSingleField('nameForm', 'nameField', 'nameButton', 'nameInput', 'Change Name', 'Save Name')">
                    Change Name
                </button>
            </form>

            @* Change Email *@
            <form id="emailForm"
                  asp-controller="User"
                  asp-action="ChangeEmail"
                  method="post"
                  class="mb-3">

                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />

                <input class="changeEmail emailInput form-control mb-2"
                       type="email"
                       name="email"
                       placeholder="Нов имейл"
                       autocomplete="email"
                       hidden
                       disabled
                       required />

                <input class="changeEmail emailInput form-control mb-2"
                       type="password"
                       name="currentPassword"
                       placeholder="Текуща парола"
                       autocomplete="current-password"
                       hidden
                       disabled
                       required />

                <button type="button"
                        id="emailButton"
                        class="btn btn-primary"
                        onclick="toggleMultipleFields('emailForm', 'changeEmail', 'emailButton', 'emailInput', 'Change Email', 'Save Email')">
                    Change Email
                </button>
            </form>

            @* Change Password *@
            <form id="passwordForm"
                  asp-controller="User"
                  asp-action="ChangePassword"
                  method="post"
                  class="mb-3">

                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />

                <input class="changePassword passwordInput form-control mb-2"
                       type="password"
                       name="currentPassword"
                       placeholder="Текуща парола"
                       autocomplete="current-password"
                       hidden
                       disabled
                       required />

                <input class="changePassword passwordInput form-control mb-2"
                       type="password"
                       name="newPassword"
                       placeholder="Нова парола"
                       autocomplete="new-password"
                       hidden
                       disabled
                       required />

                <input class="changePassword passwordInput form-control mb-2"
                       type="password"
                       name="confirmPassword"
                       placeholder="Потвърди нова парола"
                       autocomplete="new-password"
                       hidden
                       disabled
                       required />

                <button type="button"
                        id="passwordButton"
                        class="btn btn-primary"
                        onclick="toggleMultipleFields('passwordForm', 'changePassword', 'passwordButton', 'passwordInput', 'Change Password', 'Save Password')">
                    Change Password
                </button>
            </form>
        }
        else
        {
           
        }
    </div>

    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-secondary">
       Обратно
    </a>
</div>
