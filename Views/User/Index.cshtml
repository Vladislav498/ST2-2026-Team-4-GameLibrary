@model IEnumerable<ST2_2026_Team_4_GameLibrary.Models.User>

@{
    ViewData["Title"] = "Потребители";
}

<h1>Потребители</h1>

@if (!Model.Any())
{
    <p>Няма потребители.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Потребителско име</th>
                <th>Имейл</th>
                <th>Телефон</th>
                @if (User.IsInRole("Admin"))
                {
                    <th>Действия</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.UserName</td>
                    <td>@user.Email</td>
                    <td>@user.PhoneNumber</td>
                    @if (User.IsInRole("Admin"))
                    {
                        <td>
                            <a asp-action="Edit" asp-route-id="@user.Id">Редактирай</a> |
                            <a asp-action="Delete" asp-route-id="@user.Id">Изтрий</a>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}
