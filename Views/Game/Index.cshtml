@model IEnumerable<ST2_2026_Team_4_GameLibrary.Models.Game>

@{
    ViewData["Title"] = "Каталог с игри";
}

<h1>Каталог с игри</h1>


<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">AI търсене на игри</h5>
        <p class="text-muted">
            Опиши на естествен език каква игра търсиш.
        </p>

        <form asp-action="Index" method="get">
            <div class="input-group">
                <input
                    type="text"
                    name="aiQuery"
                    class="form-control"
                    placeholder="Например: Намери ми RPG игри"
                    value="@ViewBag.AiQuery" />

                <button type="submit" class="btn btn-primary">
                    <span class="me-1">✨</span> AI търсене
                </button>
            </div>
        </form>
    </div>
</div>



@if (User.IsInRole("Admin"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Добави игра</a>
    </p>
}

<form asp-action="Index" method="get" class="mb-3">
    <label for="genre" class="form-label">Филтър по жанр</label>

    <select name="genre" id="genre" class="form-select" onchange="this.form.submit()">
        <option value="">Всички жанрове</option>

        @foreach (string genre in (IEnumerable<string>)ViewBag.Genres)
        {
            if (genre == (string?)ViewBag.SelectedGenre)
            {
                <option value="@genre" selected>@genre</option>
            }
            else
            {
                <option value="@genre">@genre</option>
            }
        }
    </select>
</form>

@if (!Model.Any())
{
    <p>Все още няма добавени игри.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Заглавие</th>
                <th>Жанр</th>
                <th>Разработчик</th>
                <th>Дата на издаване</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var game in Model)
            {
                <tr>
                    <td>@game.Title</td>
                    <td>@game.Genre</td>
                    <td>@game.Developer</td>
                    <td>@game.ReleaseDate.ToString("dd.MM.yyyy")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@game.Id">Детайли</a>
                        @if (User.IsInRole("Admin"))
                        {
                            <span> | <a asp-action="Edit" asp-route-id="@game.Id">Редактирай</a></span>
                            <span> | <a asp-action="Delete" asp-route-id="@game.Id">Изтрий</a></span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
