
  <div class="game-heading">
      <h1>@Model.Title</h1>
  </div>

<div class="game-details-layout">


    <div class="game-details-image">
        @if (!string.IsNullOrEmpty(Model.ImagePath))
        {
            <img src="@Model.ImagePath" alt="@Model.Title" />
        }
        else
        {
            <div class="game-details-no-image">🎮</div>
        }
    </div>

    <div class="game-details-info">
        <p><strong>Жанр:</strong> @Model.Genre</p>
        <p><strong>Разработчик:</strong> @Model.Developer</p>
        <p>
            <strong>Дата на издаване:</strong>
            @Model.ReleaseDate.ToString("dd.MM.yyyy")
        </p>

        <p><strong>Описание:</strong></p>
        <p>
            @(string.IsNullOrWhiteSpace(Model.Description)
                ? "Няма добавено описание."
                : Model.Description)
        </p>
    </div>

</div>

