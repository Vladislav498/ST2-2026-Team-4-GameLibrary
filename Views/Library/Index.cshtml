@model IEnumerable<ST2_2026_Team_4_GameLibrary.Models.Game>

@{
    ViewData["Title"] = "Моята библиотека";
}

<style>
    .games-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 25px;
        margin-bottom: 30px;
    }

    .game-card {
        background: var(--light-base);
        border: 1px solid #444;
        border-radius: 10px;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        display: flex;
        flex-direction: column;
    }

        .game-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
        }

    .game-image {
        width: 100%;
        height: 200px;
        background: var(--dark-base);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text-primary);
        font-size: 3rem;
        overflow: hidden;
    }

        .game-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .game-info {
        padding: 20px;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .game-title {
        font-size: 1.3rem;
        font-weight: bold;
        margin-bottom: 10px;
        color: var(--text-primary);
    }

    .game-description {
        color: var(--text-secondary);
        font-size: 0.9rem;
        margin-bottom: 15px;
        flex-grow: 1;
        line-height: 1.5;
    }

    .game-info p {
        color: var(--text-secondary);
        margin-bottom: 8px;
    }

    .game-actions {
        display: flex;
        gap: 10px;
        margin-top: 15px;
    }

        .game-actions form {
            flex: 1;
        }

        .game-actions .btn {
            width: 100%;
        }

    .btn-view {
        flex: 1;
        padding: 10px;
        background-color: var(--accent);
        color: white;
        border: none;
        border-radius: 5px;
        text-decoration: none;
        text-align: center;
        font-weight: bold;
    }

        .btn-view:hover {
            background-color: var(--accent-dark);
            color: white;
        }

    .no-games {
        text-align: center;
        padding: 60px 20px;
        background: var(--light-base);
        border: 1px solid #444;
        border-radius: 10px;
        color: var(--text-secondary);
    }

    .no-games-icon {
        font-size: 4rem;
        margin-bottom: 20px;
    }

    @@media (max-width: 576px) {
        .game-actions {
            flex-direction: column;
        }
    }
</style>

<div class="profile-container">

    <h2 class="profile-heading">Моята библиотека</h2>

    <p class="text-muted">
        Всички игри, които си добавил към личната си библиотека.
    </p>

    <div class="profile-card">

        @if (Model != null && Model.Any())
        {
            <div class="games-grid">
                @foreach (var game in Model)
                {
                    <div class="game-card">

                        <div class="game-image">
                            @if (!string.IsNullOrEmpty(game.ImagePath))
                            {
                                <img src="@game.ImagePath" alt="@game.Title" />
                            }
                            else
                            {
                                <div>🎲</div>
                            }
                        </div>

                        <div class="game-info">

                            <div class="game-title">
                                @game.Title
                            </div>

                            <div class="game-description">
                                @if (!string.IsNullOrEmpty(game.Description))
                                {
                                    @(game.Description.Length > 100
                                        ? game.Description.Substring(0, 100) + "..."
                                        : game.Description)
                                }
                            </div>

                            <p>
                                <strong>Жанр:</strong> @game.Genre
                            </p>

                            <p>
                                <strong>Разработчик:</strong> @game.Developer
                            </p>

                            <div class="game-actions">

                                <a asp-controller="Game"
                                   asp-action="Details"
                                   asp-route-id="@game.Id"
                                   class="btn-view">
                                    Детайли
                                </a>

                                <form asp-controller="Library"
                                      asp-action="Remove"
                                      method="post">

                                    <input type="hidden"
                                           name="gameId"
                                           value="@game.Id" />

                                    <button type="submit"
                                            class="btn btn-danger">
                                        Премахни
                                    </button>

                                </form>

                            </div>

                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="no-games">
                <div class="no-games-icon">🎮</div>

                <p>Все още нямаш добавени игри.</p>

                <a asp-controller="Game"
                   asp-action="Index"
                   class="btn btn-primary">
                    Разгледай каталога
                </a>
            </div>
        }

    </div>
</div>
